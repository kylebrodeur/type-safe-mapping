{
  "name": "@kylebrodeur/type-safe-mapping",
  "version": "0.3.0",
  "description": "Zero-duplication field mapping for TypeScript with full type safety and inference",
  "keywords": [
    "typescript",
    "mapping",
    "type-safe",
    "field-mapping",
    "zero-duplication",
    "bidirectional",
    "api-mapping",
    "dto",
    "data-transformation",
    "type-inference",
    "type-safety",
    "domain-model",
    "snake-case",
    "camel-case",
    "orm",
    "serialization"
  ],
  "author": "Kyle Brodeur",
  "license": "MIT",
  "type": "module",
  "private": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/kylebrodeur/type-safe-mapping.git"
  },
  "bugs": {
    "url": "https://github.com/kylebrodeur/type-safe-mapping/issues"
  },
  "homepage": "https://github.com/kylebrodeur/type-safe-mapping#readme",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "lint": "eslint .",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run typecheck && npm test && npm run build"
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "devDependencies": {
    "@typescript-eslint/eslint-plugin": "^8.56.1",
    "@typescript-eslint/parser": "^8.56.1",
    "eslint": "^10.0.3",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.8.1",
    "typescript": "^5.9.3",
    "vitest": "^4.0.18"
  }
}
